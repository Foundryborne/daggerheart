<div class="effects-sections">
    {{> "fieldset" title="DAGGERHEART.GENERAL.activeEffects" effects=effects.actives type="base"}}
    {{> "fieldset" title="DAGGERHEART.GENERAL.ephemeralEffects" effects=effects.ephemerals type="ephemeral" hideDisable="true" }}
    {{> "fieldset" title="DAGGERHEART.GENERAL.inactiveEffects" effects=effects.inactives type="base" disabled=true}}
</div>

{{#*inline "fieldset"}}
    <fieldset class="glassy drop-section">
        <legend>
            {{localize title}}
            {{#if (and @root.editable (not disabled))}}
                <a data-action="createDoc" data-document-class="ActiveEffect" data-type="{{type}}" data-tooltip="{{localize 'DOCUMENT.Create' type=type}}">
                    <i class="fa-solid fa-plus icon-button" inert></i>
                </a>
            {{/if}}
        </legend>
        <ul class="items-list">
            {{#each effects as |data|}}
                {{> 'daggerheart.inventory-item'
                    item=data.effect
                    suppressed=data.suppressed
                    invalid=data.invalid
                    suppressedMessage=data.suppressedMessage
                    type="effect"
                    actorType=(ifThen ../actorType ../actorType @root.document.type)
                    hideResources=true
                    hideDisable=../hideDisable
                    disabled=../disabled
                }}
            {{/each}}
        </ul>
    </fieldset>
{{/inline}}