<section class='tab {{tabs.features.cssClass}} {{tabs.features.id}}' data-tab='{{tabs.features.id}}' data-group='{{tabs.features.group}}'>
    <fieldset class="two-columns" spellcheck="false">
        <legend>{{localize "DAGGERHEART.GENERAL.Tabs.settings"}}</legend>
        <span data-tooltip="{{systemFields.loreReference.hint}}">{{systemFields.loreReference.label}}</span>
        {{formInput systemFields.loreReference value=source.system.loreReference}}
    </fieldset>
    {{log @root}}
    {{> 'daggerheart.inventory-items'
        title='DAGGERHEART.GENERAL.features'
        type='feature'
        collection=features
        canCreate=document.parent
        showActions=false
    }}
</section>