<section
    class='tab {{tabs.features.cssClass}} {{tabs.features.id}}'
    data-tab='{{tabs.features.id}}'
    data-group='{{tabs.features.group}}'
>
    <fieldset class="two-columns" spellcheck="false">
        <legend>{{localize "DAGGERHEART.GENERAL.Tabs.settings"}}</legend>
        <span data-tooltip="{{systemFields.loreReference.hint}}">{{systemFields.loreReference.label}}</span>
        {{formInput systemFields.loreReference value=(coalesce source.system.loreReference "")}}
    </fieldset>
    {{> featuresSection label=(localize "DAGGERHEART.ITEMS.Ancestry.primaryFeature") type="primary" features=primaryFeatures}}
    {{> featuresSection label=(localize "DAGGERHEART.ITEMS.Ancestry.secondaryFeature") type="secondary" features=secondaryFeatures}}
</section>

{{#*inline "featuresSection"}}
    <fieldset class="one-column drop-section" data-type="{{type}}">
        <legend>
            {{label}} 
        </legend>
        <div class="feature-list">
            {{#each features as |feature|}}
                <div class="feature-line"
                    data-item-uuid="{{feature.uuid}}"
                    data-type="{{../type}}"
                    data-item-id="{{feature._id}}"
                >
                    {{#if feature}}
                        <img class="image" src="{{feature.img}}" />
                        <span>{{feature.name}}</span>
                    {{else}}
                        <i class="fa-solid fa-link-slash hint image-icon" inert></i>
                        <span class="hint">{{localize "DAGGERHEART.GENERAL.missingX" x=(localize "TYPES.Item.feature")}}</span>
                    {{/if}}
                    <div class="controls">
                        {{#if feature}}
                            <a class="effect-control" data-action='editDoc' data-tooltip="DAGGERHEART.UI.Tooltip.openItemWorld">
                                <i class="fa-solid fa-globe"></i>
                            </a>
                        {{/if}}
                        <a data-action="deleteFeature"><i class="fa-solid fa-trash"></i></a>
                    </div>
                </div>
            {{else}}
                <div class="drag-area">{{localize "DAGGERHEART.GENERAL.missingDragDropThing" thing=(localize "TYPES.Item.feature")}}</div>
            {{/each}}
        </div>
    </fieldset>
{{/inline}}