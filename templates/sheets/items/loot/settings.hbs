<section
    class='tab {{tabs.settings.cssClass}} {{tabs.settings.id}}'
    data-tab='{{tabs.settings.id}}'
    data-group='{{tabs.settings.group}}'
>
    <fieldset class="standard-form">
        <legend>{{localize tabs.settings.label}}</legend>
        {{#if choices}}        
            {{formGroup systemFields.category value=source.system.category choices=choices localize=true}}
        {{/if}}
        {{formGroup systemFields.quantity value=source.system.quantity localize=true}}
    </fieldset>

    {{#if categoryData}}
        <fieldset class="standard-form">
            <legend>{{localize categoryDataLabel}}</legend>
            {{#each categoryData as |entry key|}}
                {{formGroup entry.field localize=true name=entry.name value=entry.value}}
            {{/each}}
        </fieldset>
    {{/if}}
</section>