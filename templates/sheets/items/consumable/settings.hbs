<section
    class='tab {{tabs.settings.cssClass}} {{tabs.settings.id}}'
    data-tab='{{tabs.settings.id}}'
    data-group='{{tabs.settings.group}}'
>
    <fieldset class="standard-form">
        <legend>{{localize tabs.settings.label}}</legend>
        {{formGroup systemFields.quantity value=source.system.quantity}}
        {{formGroup systemFields.consumeOnUse value=source.system.consumeOnUse id=(concat @root.partId "-consumeOnUse")}}
    </fieldset>
</section>