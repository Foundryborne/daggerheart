<section
    class='tab {{tabs.settings.cssClass}} {{tabs.settings.id}}'
    data-tab='{{tabs.settings.id}}'
    data-group='{{tabs.settings.group}}'
>
    <fieldset class="standard-form">
        <legend>
            {{localize tabs.settings.label}}
            <a data-action="configureAttack" data-tooltip="{{localize 'DAGGERHEART.ITEMS.Weapon.configureAttack'}}"><i class="fa-solid fa-wrench icon-button"></i></a>
        </legend>
        {{formGroup systemFields.tier value=source.system.tier localize=true}}
        {{formGroup systemFields.secondary value=source.system.secondary localize=true}}
        {{formGroup systemFields.attack.fields.roll.fields.trait value=source.system.attack.roll.trait name="system.attack.roll.trait" localize=true}}
        {{formGroup systemFields.attack.fields.range value=source.system.attack.range name="system.attack.range" localize=true}}
        {{formGroup systemFields.burden value=source.system.burden localize=true}}
    </fieldset>

    {{#with systemFields.attack.fields.damage.fields.main.fields as | fields | }}
        {{#with ../source.system.attack.damage.main as | source | }}
            <fieldset class="standard-form">
                <legend>{{localize "DAGGERHEART.GENERAL.damage"}}</legend>
                {{formGroup fields.value.fields.custom.fields.enabled value=source.value.custom.enabled name="system.attack.damage.main.value.custom.enabled" localize=true}}
                {{#if source.value.custom.enabled}}
                    {{formGroup fields.value.fields.custom.fields.formula value=source.value.custom.formula name="system.attack.damage.main.value.custom.formula" localize=true}}
                {{else}}
                    {{formGroup fields.value.fields.dice value=source.value.dice name="system.attack.damage.main.value.dice" localize=true}}
                    {{formGroup fields.value.fields.bonus value=source.value.bonus name="system.attack.damage.main.value.bonus" localize=true}}
                {{/if}}
                {{formGroup fields.type value=source.type name="system.attack.damage.main.type" localize=true}}
                {{formGroup @root.systemFields.attack.fields.damage.fields.main.fields.direct value=@root.source.system.attack.damage.main.direct name="system.attack.damage.main.direct" localize=true}}
                <input type="hidden" name="system.attack.damage.main.value.multiplier" value="{{source.value.multiplier}}">
            </fieldset>
        {{/with}}
    {{/with}}
    <fieldset class="standard-form">
        <legend>{{localize "TYPES.Item.feature"}}</legend>
        <div class="form-group">
            <label>
                {{localize "TYPES.Item.feature"}}
                {{#if featureErrors}}
                    <i class="warning-icon fa-solid fa-triangle-exclamation" data-tooltip="{{featureErrors}}"></i>
                {{/if}}
            </label>
            <div class="form-fields">
                <input type="text" class="features-input" value="{{features}}" />
            </div>
        </div>
    </fieldset>
    {{#each featureConfigs as |config|}}
        <fieldset class="standard-form">
            <legend>{{config.label}}</legend>
            {{#each config.data as |entry key|}}
                {{formGroup entry.field localize=true name=entry.name value=entry.value}}
            {{/each}}
        </fieldset>
    {{/each}}
    {{> "systems/daggerheart/templates/sheets/global/partials/resource-section/resource-section.hbs" }}
</section>