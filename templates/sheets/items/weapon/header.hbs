<header class='item-sheet-header'>
    <img class='profile' src='{{source.img}}' data-action='editImage' data-edit='img' />
    <div class='item-info'>
        <line-div></line-div>
        <h1 class='item-name'><input type='text' name='name' value='{{source.name}}' /></h1>
        <div class='item-description'>
            <h3>
                {{
                    localize "DAGGERHEART.ITEMS.Weapon.header"
                    tier=document.system.tier
                    type=(localize (ifThen source.system.secondary "DAGGERHEART.ITEMS.Weapon.secondaryWeapon.short" "DAGGERHEART.ITEMS.Weapon.primaryWeapon.short"))
                }}
            </h3>
            <h3>
                {{weaponTraitLabel}}
                <span>-</span>
                {{localize (concat 'DAGGERHEART.CONFIG.Range.' source.system.attack.range '.name')}}
                {{#if formula}}
                    <span>-</span>
                    <span>
                        {{formula}}
                        {{#each damageTypes as |type|}}
                            {{~localize type.abbreviation~}}
                            {{#unless @last}}/{{/unless~}}
                        {{/each}}
                    </span>
                {{/if}}
                <span>-</span>
                {{localize (concat 'DAGGERHEART.CONFIG.Burden.' source.system.burden)}}
            </h3>
        </div>
    </div>
</header>