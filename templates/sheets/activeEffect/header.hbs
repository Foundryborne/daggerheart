<header class='item-sheet-header'>
    <img class='profile' src="{{source.img}}" data-action="editImage" data-edit="img" alt="{{localize " EFFECT.FIELDS.img.label"}}">
    <div class='item-info'>
        <h1 class='item-name'><input name="name" type="text" value="{{source.name}}" placeholder="{{localize " EFFECT.FIELDS.name.label"}}" aria-label="{{localize " EFFECT.FIELDS.name.label"}}"></h1>
        {{#if document.item}}<h3 {{#if document.item.visible}}data-item-id="{{document.item.uuid}}" data-action="showItem" {{/if}}>{{document.item.name}}</h3>{{/if}}
    </div>
</header>