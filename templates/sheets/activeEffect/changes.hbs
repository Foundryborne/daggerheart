<section class="tab changes{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <div class="basic-changes">
        <header>
            <div class="key">{{localize "EFFECT.FIELDS.changes.element.key.label"}}</div>
            <div class="type">{{localize "EFFECT.FIELDS.changes.element.type.label"}}</div>
            <div class="value">{{localize "EFFECT.FIELDS.changes.element.value.label"}}</div>
            <div class="priority">{{localize "EFFECT.FIELDS.changes.element.priority.label"}}</div>
            <div class="controls">
                <a class="inline-control icon" data-action="addChange"><i class="fa-regular fa-square-plus"></i></a>
            </div>
        </header>
        <ol data-changes>
            {{#each changes as |change|}}
                {{{change}}}
            {{/each}}
        </ol>
    </div>

    {{#each typedChanges.bonus as |bonus|}}
        <fieldset class="typed-change-container optional" data-type="bonus">
            <legend>
                {{localize "DAGGERHEART.EFFECTS.ChangeTypes.bonus.name"}} 
                <a class="icon fa-solid fa-trash" data-action="removeCustomChange" data-index="{{bonus.index}}" data-type="bonus"></a>
            </legend>
            {{> "systems/daggerheart/templates/sheets/activeEffect/typeChanges/bonus.hbs" bonus fields=@root.systemFields.changes.element.types.bonus.fields}}
        </fieldset>
    {{/each}}

    {{#each typedChanges.bonusAdjustment as |bonusAdjustment|}}
        <fieldset class="typed-change-container optional" data-type="bonusAdjustment">
            <legend>
                {{localize "DAGGERHEART.EFFECTS.ChangeTypes.bonusAdjustment.name"}} 
                <a class="icon fa-solid fa-trash" data-action="removeCustomChange" data-index="{{bonusAdjustment.index}}" data-type="bonusAdjustment"></a>
            </legend>
            {{> "systems/daggerheart/templates/sheets/activeEffect/typeChanges/bonusAdjustment.hbs" bonusAdjustment fields=@root.systemFields.changes.element.types.bonusAdjustment.fields}}
        </fieldset>
    {{/each}}

    {{#each typedChanges.armor as |armor|}}
        <fieldset class="typed-change-container armor-change-container optional" data-type="armor">
            <legend>
                {{localize "DAGGERHEART.EFFECTS.ChangeTypes.armor.name"}} 
                <a class="icon fa-solid fa-trash" data-action="removeCustomChange" data-index="{{armor.index}}" data-type="armor"></a>
            </legend>
            {{> "systems/daggerheart/templates/sheets/activeEffect/typeChanges/armorChange.hbs" armor fields=@root.systemFields.changes.element.types.armor.fields}}
        </fieldset>
    {{/each}}

    {{#each typedChanges.standardAttack as |standardAttack|}}
        <fieldset class="typed-change-container optional" data-type="standardAttack">
            <legend>
                {{localize "DAGGERHEART.EFFECTS.ChangeTypes.standardAttack.name"}} 
                <a class="icon fa-solid fa-trash" data-action="removeCustomChange" data-index="{{standardAttack.index}}" data-type="standardAttack"></a>
            </legend>
            {{> "systems/daggerheart/templates/sheets/activeEffect/typeChanges/standardAttack.hbs" standardAttack fields=@root.systemFields.changes.element.types.standardAttack.fields}}
        </fieldset>
    {{/each}}

    {{#each damageReductions as |reduction index|}}
        <fieldset class="typed-change-container optional" data-type="damageReduction">
            <legend>
                {{localize "DAGGERHEART.EFFECTS.ChangeTypes.damageReduction.name"}} 
                <a class="icon fa-solid fa-trash" data-action="removeCustomChange" data-index="{{reduction.changeIndex}}" data-type="damageReduction"></a>
            </legend>

            {{> "systems/daggerheart/templates/sheets/activeEffect/typeChanges/damageReduction.hbs" reduction index=reduction.changeIndex fields=@root.systemFields.changes.element.types.damageReduction.fields}}
        </fieldset>
    {{/each}}

    {{#if creatableTypes}}
        <div class="add-change">
            <select class="change-type">
                {{selectOptions creatableTypes}}
            </select>
            <button type="button" data-action="addCustomChange">
                <i class="fa-solid fa-plus" inert></i> {{localize "DAGGERHEART.EFFECTS.AddChange"}}
            </button>
        </div>
    {{/if}}
</section>
