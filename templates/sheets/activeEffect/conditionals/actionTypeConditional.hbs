<fieldset class="conditional-container">
    <legend>
        {{localize "DAGGERHEART.CONFIG.ConditionalType.actionType"}}
        <a data-action="removeConditional" data-index="{{@key}}"><i class="fa-solid fa-trash" inert></i></a>
    </legend>
    <div class="conditional-inner-container">
        <input type="hidden" value="{{this.type}}" name="{{concat "system.conditionals." @key ".type"}}" />
        {{formGroup model.fields.actionTypes value=this.actionTypes name=(concat "system.conditionals." @key ".actionTypes") localize=true blank=false }}
        {{formGroup model.fields.traits value=this.traits name=(concat "system.conditionals." @key ".traits") localize=true blank=true }}
    </div>
</fieldset>