<input type="hidden" name="{{concat "system.changes." index ".type"}}" value="{{type}}" />
<input type="hidden" name="{{concat "system.changes." index ".phase"}}" value="{{phase}}" />
<input type="hidden" name="{{concat "system.changes." index ".priority"}}" value="{{priority}}" />

<div class="two-columns even">
    <div class="form-group">
        <label>{{localize "DAGGERHEART.GENERAL.label"}}</label>
        <div class="form-fields">
            <input type="text" name="{{concat "system.changes." index ".value.label"}}" value="{{value.label}}" placeholder="{{@root.document.name}}" data-placeholder-is-name />
        </div>
    </div>
    {{formField fields.value.fields.value name=(concat "system.changes." index ".value.value") value=value.value localize=true}}
</div>

<div class="one-column">
    <fieldset class="optional">
        <legend>
            <span>{{localize "DAGGERHEART.GENERAL.Cost.plural"}}</span>
            <a data-action="addDamageReductionCost" data-reduction-index="{{index}}"><i class="fa-solid fa-plus"></i></a>
        </legend>

        {{#each value.costs as |cost costIndex|}}
            <div class="nest-inputs">
                <div class="form-group">
                    <label>{{localize "DAGGERHEART.GENERAL.type"}}</label>
                    <div class="form-fields">
                        <select name="{{concat "system.changes." ../index ".value.costs." costIndex ".type"}}" class="damage-reduction-cost-type-field">
                            {{selectOptions cost.costOptions selected=cost.type localize=true}}
                        </select>
                    </div>
                </div>
                {{formField ../fields.value.fields.costs.element.fields.value name=(concat "system.changes." ../index ".value.costs." costIndex ".value") value=cost.value localize=true}}
                <a class="column-delete-icon" data-action="deleteDamageReductionCost" data-reduction-index="{{../index}}" data-cost-index="{{costIndex}}"><i class="fa-solid fa-trash"></i></a>
            </div>
        {{/each}}
    </fieldset>
</div>

