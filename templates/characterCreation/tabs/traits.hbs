<section
    class='tab {{tabs.traits.cssClass}} {{tabs.traits.id}}'
    data-tab='{{tabs.traits.id}}'
    data-group='{{tabs.traits.group}}'
>
   <div class="main-selections-container">
        <div class="step-sidebar">
            <h1 class="title-section">4. Assign Traits</h1>

            <div class="compedium-list traits">
                <h1 class="subtitle-section">
                    {{localize 'DAGGERHEART.APPLICATIONS.CharacterCreation.suggestedTraits'}}
                    <side-line-div></side-line-div>
                </h1>
                <ul>
                    {{#each suggestedTraits}}
                        <li class="suggested-trait-container subtitle-section">{{this}}</li>
                    {{/each}}
                </ul>
                <button data-action="useSuggestedTraits">
                    Apply Suggested Traits
                </button>
            </div>
        </div>
        <line-div></line-div>
        <div class="floating-container trait">
            <div class="traits-info">
                <h1 class="subtitle-section">
                    {{localize "DAGGERHEART.APPLICATIONS.CharacterCreation.traitsTab.title"}}
                    <side-line-div></side-line-div>
                </h1>
                <div class="m-top-10">
                    <p>{{localize "DAGGERHEART.APPLICATIONS.CharacterCreation.traitsTab.paragraph1"}}</p>
                    <p>{{localize "DAGGERHEART.APPLICATIONS.CharacterCreation.traitsTab.paragraph2"}}</p>
                </div>
                <div class="trait-list m-top-20">
                    {{#each traits.values as |trait|}}
                        <div class="trait-container">
                            <div class="trait-header">
                                <div class="trait-label">
                                    <h1 class="title-section">{{trait.name}}</h1>
                                    <div class="suggestion-list">
                                        {{#each verbs as |verb index|}}
                                            <p class="subtitle-trait">{{localize verb}}{{#unless (eq ../verbs.length (add index 1))}}, {{/unless}}</p>
                                        {{/each}}
                                    </div>
                                </div>
                                <side-line-div></side-line-div>
                                <div class="trait-select-container">
                                    <select name="{{concat "traits." trait.key ".value"}}" data-dtype="Number">
                                        {{selectOptions trait.options selected=trait.value valueAttr="key" labelAttr="value" blank=""}}
                                    </select>
                                </div>
                            </div>
                            <p class="trait-description m-top-10">
                                {{trait.description}}
                            </p>
                        </div>
                    {{/each}}
                </div>
            </div>
        </div>
   </div>
</section>