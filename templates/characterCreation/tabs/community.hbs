<section
    class='tab {{tabs.community.cssClass}} {{tabs.community.id}}'
    data-tab='{{tabs.community.id}}'
    data-group='{{tabs.community.group}}'
>
    <div class="main-selections-container">
        <div class="step-sidebar">
            <h1 class="title-section">3. Choose a Community</h1>

            <div class="community compedium-list">
                {{!-- {{#each communityGroups}}
                <div class="{{label}} compedium-item">
                    <h1 class="subtitle-section">
                        {{label}}
                        <side-line-div></side-line-div>
                    </h1>
                    <ul>
                        {{> "systems/daggerheart/templates/characterCreation/partials/sidebar-item.hbs"
                            items=items
                            action="selectItem"}}
                    </ul>
                </div>
                {{/each}} --}}
                <h2 class="subtitle-section">
                    {{localize 'DAGGERHEART.APPLICATIONS.CharacterCreation.tabs.community'}}
                    <side-line-div></side-line-div>
                </h2>
                {{> selectedItem
                    item=community
                    type='community'
                    emptyMessage='Select a Community'
                }}
            </div>
        </div>
        <line-div></line-div>
        {{!-- {{#if community.name}}
            <div class="community-info">
                <h1 class="title-section">{{community.name}}</h1>
                <div class="d-flex container">
                    <img src="{{community.img}}" alt="">
                    <div class="description">
                        {{{community.system.description}}}
                        {{> communityFeatures subtitle='DAGGERHEART.ITEMS.Community.featuresLabel' type='community' list=community.system.features}}
                    </div>
                </div>
            </div>
        {{/if}} --}}

        <div class="comunity-list card-list">
            {{#each communityGroups.items as |community|}}
                <a class="card {{#if ../community.name}}{{#unless (eq ../community.name community.name)}}not-selected{{/unless}}{{/if}}" data-uuid="{{community.uuid}}" data-type="{{community.type}}" data-action="selectItem">
                    {{{community.embedCard}}}
                </a>
            {{/each}}
        </div>
    </div>
</section>

{{#*inline "communityFeatures"}}
    <div class="{{type}}-feature m-top-20">
        <h2 class="subtitle-section">
            {{localize subtitle}}
            <side-line-div></side-line-div>
        </h2>
        {{#each list as |feature|}}
            <div class="m-top-10">
                <i><b>{{{feature.name}}}:</b></i>
                {{{feature.system.description}}}
            </div>
        {{/each}}
    </div>
{{/inline}}

{{#*inline "selectedItem"}}
    {{#if item.name}}
        <div class="equip-items">
            <img src="{{item.img}}" alt="{{item.name}}">
            <p>{{item.name}}</p>
            <a class="delete"><i class="fa-solid fa-xmark" data-id="{{id}}" data-type="{{type}}" data-item-type="community" data-action="removeSelectedItem"></i></a>
        </div>
    {{else}}
        <div class="empty-slot">
            {{emptyMessage}}
        </div>
    {{/if}}
{{/inline}}