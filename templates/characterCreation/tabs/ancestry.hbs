<section
    class='tab {{tabs.ancestry.cssClass}} {{tabs.ancestry.id}}'
    data-tab='{{tabs.ancestry.id}}'
    data-group='{{tabs.ancestry.group}}'
>
    <div class="main-selections-container">
        <div class="step-sidebar">
            <h1 class="title-section">2. Choose a Ancestry</h1>
            <input type="checkbox" data-action="mixedAncestryToggle" {{checked mixedAncestry}}/>
            <span>{{localize "DAGGERHEART.APPLICATIONS.CharacterCreation.mixedAncestry"}}</span>

            <div class="ancestry compedium-list m-top-10">
                {{!-- {{#each ancestryGroups}}
                <div class="{{label}} compedium-item">
                    <h1 class="subtitle-section">
                        {{label}}
                        <side-line-div></side-line-div>
                    </h1>
                    <ul>
                        {{> "systems/daggerheart/templates/characterCreation/partials/sidebar-item.hbs"
                            items=items
                            action="selectItem"}}
                    </ul>

                </div>
                {{/each}} --}}
                <h2 class="subtitle-section">
                    {{localize 'DAGGERHEART.APPLICATIONS.CharacterCreation.tabs.ancestry'}}
                    <side-line-div></side-line-div>
                </h2>
                {{> selectedItem
                    item=primaryAncestry
                    type='primaryAncestry'
                    emptyMessage='Select a Ancestry'
                }}
                {{#if mixedAncestry}}
                    {{> selectedItem
                        item=secondaryAncestry
                        type='secondaryAncestry'
                        emptyMessage='Select a Ancestry'
                    }}

                    <h2 class="subtitle-section m-top-20">
                        {{localize 'DAGGERHEART.APPLICATIONS.CharacterCreation.selectPrimaryAncestry'}}
                        <side-line-div></side-line-div>
                    </h2>
                    {{> ancestryFeature
                        name='primary-ancestry'
                        elementId='primary-feature'
                        ancestry=primaryAncestry
                        uuid=primaryAncestry.system.primaryFeature.uuid
                        mixedUuid=mixedFeatures.primaryFeature.uuid 
                        ancestryType='primary'
                        featureType='primary'
                    }}
                    {{> ancestryFeature
                        name='primary-ancestry'
                        elementId='secondary-feature'
                        ancestry=primaryAncestry
                        uuid=primaryAncestry.system.secondaryFeature.uuid
                        mixedUuid=mixedFeatures.secondaryFeature.uuid 
                        ancestryType='primary'
                        featureType='secondary'
                    }}

                    {{#if secondaryAncestry.name}}
                    <h2 class="subtitle-section m-top-10">
                        {{localize 'DAGGERHEART.APPLICATIONS.CharacterCreation.selectSecondaryAncestry'}}
                        <side-line-div></side-line-div>
                    </h2>
                    {{> ancestryFeature
                        name='secondary-ancestry'
                        elementId='primary-feature'
                        ancestry=secondaryAncestry
                        uuid=secondaryAncestry.system.primaryFeature.uuid
                        mixedUuid=mixedFeatures.primaryFeature.uuid 
                        ancestryType='primary'
                        featureType='primary'
                    }}
                    {{> ancestryFeature
                        name='secondary-ancestry'
                        elementId='secondary-feature'
                        ancestry=secondaryAncestry
                        uuid=secondaryAncestry.system.secondaryFeature.uuid
                        mixedUuid=mixedFeatures.secondaryFeature.uuid 
                        ancestryType='primary'
                        featureType='secondary'
                    }}
                    {{/if}}
                {{/if}}
            </div>
        </div>

        <line-div></line-div>

        <div class="ancestry-list card-list">
            {{#each ancestryGroups.items as |ancestry|}}
                <a 
                    class="card {{#if ../primaryAncestry.name}}{{#unless (or (eq ../primaryAncestry.name ancestry.name) (eq ../secondaryAncestry.name ancestry.name))}}not-selected{{/unless}}{{/if}}"
                    data-uuid="{{ancestry.uuid}}" data-type="{{ancestry.type}}" data-action="selectItem"
                >
                    {{{ancestry.embedCard}}}
                </a>
            {{/each}}
        </div>
    </div>
</section>

{{#*inline "ancestryFeature"}}
    <div class="ancestry-feature" >
        {{#if mixedAncestry}}
            <input
                type="radio"
                name="{{name}}"
                id="{{elementId}}"
                data-action="selectAncestryFeature"
                data-uuid="{{uuid}}"
                data-ancestry-type="{{ancestryType}}"
                data-feature-type="{{featureType}}"
                {{checked (eq mixedUuid uuid)}}
            >
        {{/if}}
        <div for="{{elementId}}">
            {{#if (eq featureType 'primary')}}
                <b>{{{ancestry.system.primaryFeature.name}}}</b>
            {{else}}
                <b>{{{ancestry.system.secondaryFeature.name}}}</b>
            {{/if}}
        </div>
    </div>
{{/inline}}

{{#*inline "selectedItem"}}
    {{#if item.name}}
        <div class="equip-items">
            <img src="{{item.img}}" alt="{{item.name}}">
            <p>{{item.name}}</p>
            <a class="delete"><i class="fa-solid fa-xmark" data-id="{{id}}" data-type="{{type}}" data-item-type="ancestry" data-action="removeSelectedItem"></i></a>
        </div>
    {{else}}
        <div class="empty-slot">
            {{emptyMessage}}
        </div>
    {{/if}}
{{/inline}}