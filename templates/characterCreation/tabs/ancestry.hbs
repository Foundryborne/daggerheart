<section
    class='tab {{tabs.ancestry.cssClass}} {{tabs.ancestry.id}}'
    data-tab='{{tabs.ancestry.id}}'
    data-group='{{tabs.ancestry.group}}'
>
    <div class="main-selections-container">
        <div class="step-sidebar">
            <h1 class="title-section">2. {{localize tabs.ancestry.label}}</h1>
            <label>
                <input type="checkbox" data-action="mixedAncestryToggle" {{checked mixedAncestry}}/>
                <span>{{localize "DAGGERHEART.APPLICATIONS.CharacterCreation.mixedAncestry"}}</span>
            </label>

            <div class="ancestry compedium-list m-top-10">
                <h2 class="subtitle-section">
                    {{localize 'DAGGERHEART.APPLICATIONS.CharacterCreation.tabs.ancestry'}}
                    <side-line-div></side-line-div>
                </h2>
                {{> selectedItem
                    item=primaryAncestry
                    type='primaryAncestry'
                    emptyMessage='Select a Ancestry'
                }}
                {{#if mixedAncestry}}
                    {{> selectedItem
                        item=secondaryAncestry
                        type='secondaryAncestry'
                        emptyMessage='Select a Ancestry'
                    }}

                    {{#each selections as |group|}}
                        <h2 class="subtitle-section m-top-20">
                            {{#if (eq group.ancestryType "primary")}}
                                {{localize 'DAGGERHEART.APPLICATIONS.CharacterCreation.selectPrimaryAncestry'}}
                            {{else}}
                                {{localize 'DAGGERHEART.APPLICATIONS.CharacterCreation.selectSecondaryAncestry'}}
                            {{/if}}
                            <side-line-div></side-line-div>
                        </h2>
                        {{#each group.features as |choice|}}
                            {{> ancestryFeature
                                name=(concat group.ancestryType " primary-ancestry")
                                ancestry=group.ancestry
                                feature=choice.feature
                                uuid=choice.feature.uuid
                                selected=choice.selected 
                                ancestryType=group.ancestryType
                                featureType=choice.featureType
                            }}
                        {{/each}}
                    {{/each}}
                {{else}}

                {{/if}}
            </div>
        </div>

        <line-div></line-div>

        <div class="ancestry-list card-list scroll-container">
            {{#each ancestryGroups.items as |ancestry|}}
                <a 
                    class="card {{#unless (includes @root.selectedAncestries ancestry.uuid)}}not-selected{{/unless}}"
                    data-uuid="{{ancestry.uuid}}" data-type="{{ancestry.type}}" data-action="selectItem"
                >
                    {{{ancestry.embedCard}}}
                </a>
            {{/each}}
        </div>
    </div>
</section>

{{#*inline "ancestryFeature"}}
    <div class="ancestry-feature">
        {{#if @root.mixedAncestry}}
            <input
                type="radio"
                id="creator-{{ancestryType}}-{{featureType}}"
                name="{{name}}"
                data-action="selectAncestryFeature"
                data-uuid="{{uuid}}"
                data-ancestry-type="{{ancestryType}}"
                data-feature-type="{{featureType}}"
                {{checked selected}}
            >
        {{/if}}
        <label for="creator-{{ancestryType}}-{{featureType}}">
            <strong>{{feature.name}}</strong>
        </label>
    </div>
{{/inline}}

{{#*inline "selectedItem"}}
    {{#if item.name}}
        <div class="equip-items">
            <img src="{{item.img}}" alt="{{item.name}}">
            <p>{{item.name}}</p>
            <a class="delete"><i class="fa-solid fa-xmark" data-id="{{id}}" data-type="{{type}}" data-item-type="ancestry" data-action="removeSelectedItem"></i></a>
        </div>
    {{else}}
        <div class="empty-slot">
            {{emptyMessage}}
        </div>
    {{/if}}
{{/inline}}