<section
    class='tab {{tabs.domainCards.cssClass}} {{tabs.domainCards.id}}'
    data-tab='{{tabs.domainCards.id}}'
    data-group='{{tabs.domainCards.group}}'
>
    <div class="main-selections-container">
        <div class="step-sidebar">
            <h1 class="title-section">6. Domain Cards</h1>

            <div class="compedium-list domains">
                <h1 class="subtitle-section">
                    {{localize 'DAGGERHEART.APPLICATIONS.CharacterCreation.selectedDomains'}}
                    {{selectedDomainCards}}/{{totalDomainCards}}
                    <side-line-div></side-line-div>
                </h1>
                {{#each domainCards as |card id|}}
                    {{#if card.name}}
                    <div class="domain-card" data-tooltip="#item#{{card.id}}">
                        <img src="{{card.img}}" alt="card.name">
                        <p>{{card.name}}</p>
                        <a class="delete"><i class="fa-solid fa-xmark" data-id="{{id}}" data-action="removeDomainCard"></i></a>
                    </div>
                    {{/if}}
                {{/each}}
            </div>
        </div>
        <line-div></line-div>
        <div class="domain-card-info">
            <div class="card-list m-top-20">
                {{#each domainCardGroups.items as |card|}}
                    {{#if
                        (and
                            (or
                                (eq card.system.domain (lookup ../class.system.domains 0))
                                (eq card.system.domain (lookup ../class.system.domains 1))
                            )
                            (eq card.system.level 1)
                        )
                    }}
                        {{!-- <div class="card-item" data-uuid="{{card.uuid}}" data-type="{{card.type}}" data-action="selectItem">
                            <div class="item-icons-list">
                                <span class="item-icon">
                                    <span class="recall-value">{{card.system.recallCost}}</span>
                                    <i class="fa-solid fa-bolt"></i>
                                </span>
                                <span class="item-icon">
                                    <img src="{{concat 'systems/daggerheart/assets/icons/domains/' card.system.domain '.svg'}}" alt="">
                                </span>
                            </div>
                            <img class="tooltip-image" src="{{card.img}}" />
                            <h2 class="tooltip-title">{{card.name}}</h2>
                            <div class="tags m-top-10">
                                <div class="tag">
                                    {{#with (lookup ../config.DOMAIN.cardTypes card.system.type) as | type |}}
                                        <span>{{localize type.label}}</span>
                                    {{/with}}
                                </div>
                                <div class="tag">
                                    <span>{{localize 'DAGGERHEART.GENERAL.levelShort'}} {{ card.system.level }}</span>
                                </div>
                            </div>
                            {{#if card.system.description}}      
                                <div class="tooltip-description">{{{card.system.description}}}</div>
                            {{/if}}
                        </div> --}}
                        <a class="card" data-uuid="{{card.uuid}}" data-type="{{card.type}}" data-action="selectItem">
                            {{{card.embedCard}}}
                        </a>
                    {{/if}}
                {{/each}}
            </div>
        </div>
    </div>
</section>