        --}}

    </div>
</section>

{{#*inline "selectedItem"}}
    {{#if item.name}}
        <div class="equip-items">
            <img src="{{item.img}}" alt="{{item.name}}">
            <p>{{item.name}}</p>
            <a class="delete"><i class="fa-solid fa-xmark" data-id="{{id}}" data-type="{{type}}" data-action="removeSelectedEquip"></i></a>
        </div>
    {{else}}
        <div class="empty-slot">
            {{emptyMessage}}
        </div>
    {{/if}}
{{/inline}}