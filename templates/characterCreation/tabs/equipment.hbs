    </div>
</section>

{{#*inline "selectedItem"}}
    {{#if item.name}}
        <div class="equip-items">
            <img src="{{item.img}}" alt="{{item.name}}">
            <p>{{item.name}}</p>
            <a class="delete"><i class="fa-solid fa-xmark" data-id="{{id}}" data-type="{{type}}" data-action="removeSelectedEquip"></i></a>
        </div>
    {{else}}
        <div class="empty-slot">
            {{emptyMessage}}
        </div>
    {{/if}}
{{/inline}}

{{#*inline "choiceItems"}}
    <ul class="choice-item-list">
        {{#each suggestions as |item|}}
            <span class="equip-items selectable {{#if item.selected}}selected{{/if}}" data-action="equipmentChoice" data-path="{{../path}}" data-uuid="{{item.uuid}}">
                <img src="{{item.img}}" alt="{{item.name}}">
                <span>{{item.name}}</span>

                <a>
                    <i class="fa-regular fa-circle{{#if item.selected}}-check{{/if}}"></i>
                </a>
            </span>
        {{/each}}
    </ul>
{{/inline}}