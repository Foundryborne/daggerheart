<section
    class='tab {{tabs.equipment.cssClass}} {{tabs.equipment.id}}'
    data-tab='{{tabs.equipment.id}}'
    data-group='{{tabs.equipment.group}}'
>
    <div class="main-selections-container">
        <div class="step-sidebar">
            <h1 class="title-section">6. Equipment</h1>

            <div class="compedium-list equipment">
                <div class="items item-list">
                    <h2 class="subtitle-section">
                        {{localize "DAGGERHEART.APPLICATIONS.CharacterCreation.yourEquipments"}}
                        <side-line-div></side-line-div>
                    </h2>
                    {{> selectedItem
                        item=primaryWeapon
                        type='primaryWeapon'
                        emptyMessage='Select a Primary Weapon'
                    }}
                    {{> selectedItem
                        item=secondaryWeapon
                        type='secondaryWeapon'
                        emptyMessage='Select a Secondary Weapon'
                    }}
                    {{> selectedItem
                        item=armor
                        type='armor'
                        emptyMessage='Select a Armor'
                    }}
                </div>

                <div class="choices">
                    <h2 class="subtitle-section">
                        {{localize "DAGGERHEART.APPLICATIONS.CharacterCreation.choice"}}
                        <side-line-div></side-line-div>
                    </h2>
                    <div class="d-flex m-top-10">
                        <span class="choice-side-label">
                            {{localize 'DAGGERHEART.GENERAL.or'}}
                        </span>
                        {{> choiceItems
                            suggestions=inventory.choiceA.suggestions
                            path='choiceA'
                        }}
                    </div>
                    <div class="d-flex m-top-40">
                        <span class="choice-side-label">
                            {{localize 'DAGGERHEART.GENERAL.or'}}
                        </span>
                        {{> choiceItems
                            suggestions=inventory.choiceB.suggestions
                            path='choiceB'
                        }}
                    </div>
                </div>

                <div class="start-items">
                    <h2 class="subtitle-section">
                        {{localize "DAGGERHEART.APPLICATIONS.CharacterCreation.startingItems"}}
                        <side-line-div></side-line-div>
                    </h2>
                    <div class="item-list">
                        {{#each inventory.take as |item|}}
                            <span class="equip-items">
                                <img src="{{item.img}}" alt="{{item.name}}">
                                <span>{{item.name}}</span>
                            </span>
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>

        <div class="equipment-list">
            <h2 class="subtitle-section">
                {{localize "DAGGERHEART.APPLICATIONS.CharacterCreation.equipmentList"}}
                <side-line-div></side-line-div>
            </h2>
            <div class="tab-navigation">
            <nav class="feature-tab sheet-tabs tabs">
                <a
                    class="{{#if (eq selectedTable.label equipmentGroups.primaryWeapon.label)}}active{{/if}}"
                    data-table="primaryWeapon" data-action="selectTable"
                >
                    {{equipmentGroups.primaryWeapon.label}}
                </a>
                <a
                    class="{{#if (eq selectedTable.label equipmentGroups.secondaryWeapon.label)}}active{{/if}}"
                    data-table="secondaryWeapon" data-action="selectTable"
                >
                    {{equipmentGroups.secondaryWeapon.label}}
                </a>
                <a
                    class="{{#if (eq selectedTable.label equipmentGroups.armor.label)}}active{{/if}}"
                    data-table="armor" data-action="selectTable"
                >
                    {{equipmentGroups.armor.label}}
                </a>
            </nav>
            </div>
            {{#if selectedTable}}
                <div class="item-list-header">
                    <div class="item-list-img"></div>
                    <div class="item-list-name" data-sort-key="name" data-sort-type="ASC" data-action="sortList">{{localize 'DAGGERHEART.UI.ItemBrowser.columnName'}}</div>
                        {{#each selectedTable.columns}}
                            <div data-sort-key="{{key}}" data-sort-type="" data-action="sortList">{{localize label}}</div>
                        {{/each}}
                </div>
                <div class="item-list m-top-10">
                    {{#each selectedTable.items as |item|}}
                        <div class="item-container" data-item-uuid="{{item.uuid}}" {{#if (and uuid (eq documentName "Item"))}}data-tooltip="#item#{{item.uuid}}"{{/if}} data-action="selectItem" data-type="{{item.type}}">
                            <img src="{{item.img}}" data-item-key="img" class="item-list-img">
                            <span data-item-key="name" class="item-list-name">{{item.name}}</span>
                            {{#each ../selectedTable.columns as |table|}}
                                <span data-item-key="{{table.key}}">{{#with (@root.formatLabel ../this this) as | label |}}{{{label}}}{{/with}}</span>
                            {{/each}}
                        </div>
                    {{/each}}
                </div>
            {{/if}}
        </div>

        <div class="suggested-equipments">
            <h2 class="subtitle-section">
                {{localize "DAGGERHEART.ITEMS.Class.guide.suggestedEquipment"}}
                <side-line-div></side-line-div>
            </h2>

            <div class="item-list">
                {{#if primaryWeapon.suggestion.name}}
                    <span class="equip-items">
                        <img src="{{primaryWeapon.suggestion.img}}" alt="{{primaryWeapon.suggestion.name}}">
                        <span>{{primaryWeapon.suggestion.name}}</span>
                    </span>
                {{/if}}
                {{#if secondaryWeapon.suggestion.name}}
                    <span class="equip-items">
                        <img src="{{secondaryWeapon.suggestion.img}}" alt="{{secondaryWeapon.suggestion.name}}">
                        <span>{{secondaryWeapon.suggestion.name}}</span>
                    </span>
                {{/if}}
                {{#if armor.suggestion.name}}
                    <span class="equip-items">
                        <img src="{{armor.suggestion.img}}" alt="{{armor.suggestion.name}}">
                        <span>{{armor.suggestion.name}}</span>
                    </span>
                {{/if}}
            </div>

            <button class="m-top-20" data-action="applySuggestedEquips">
                Apply Suggested Equipment
            </button>
        </div>

