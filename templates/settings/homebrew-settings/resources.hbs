<section
    class="tab {{tabs.resources.cssClass}} {{tabs.resources.id}} scrollable"
    data-tab="{{tabs.resources.id}}"
    data-group="{{tabs.resources.group}}"
>
    <div class="resource-types-container">
        {{#each settingFields.resources as |type key|}}
            <fieldset>
                <legend>
                    {{localize "DAGGERHEART.SETTINGS.Homebrew.resources.typeTitle" type=(localize (concat "TYPES.Actor." key))}}
                    <a data-action="addActorResource" data-actor-type="{{key}}"><i class="fa-solid fa-plus"></i></a>
                </legend>

                {{#each type.resources as |resource key|}}
                    {{> "systems/daggerheart/templates/sheets/global/partials/custom-resource/custom-resource.hbs" 
                        resource
                        actorType=@../key 
                        key=key
                        fields=@root.schemaFields.resources.element.fields.resources.element.fields
                        basePath=(concat "resources." @../key ".resources." key ".") 
                    }}
                {{/each}}
            </fieldset>
        {{/each}}
    </div>
</section>