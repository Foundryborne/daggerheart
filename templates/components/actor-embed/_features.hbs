<section class="features">
    <header>{{localize "DAGGERHEART.GENERAL.features"}}</header>
    {{#each featureGroups as |section|}}
        <section class="features">
            {{#each section as |feature|}}
                <div class="feature">
                    <strong class="name">{{feature.name}} - {{feature.featureForm}}:</strong>
                    {{{feature.description}}}
                </div>
            {{/each}}
        </section>
    {{/each}}
</section>