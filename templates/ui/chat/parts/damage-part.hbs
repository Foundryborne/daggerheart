<div class="roll-part damage-section dice-roll" data-action="expandRoll"{{#unless damage.active}} hidden{{/unless}}>
    <div class="roll-part-header">
        <div>
            {{#if hasHealing}}
                <span>{{localize "DAGGERHEART.ACTIONS.TYPES.healing.name"}}</span>
            {{else}}
                <span>{{localize (ifThen damage.main.isCritical "DAGGERHEART.ACTIONS.TYPES.damage.critical" "DAGGERHEART.ACTIONS.TYPES.damage.name")}}</span>
            {{/if}}
        </div>
    </div>
    <div class="roll-part-extra on-reduced">
        <div class="wrapper">
            {{#if damage.main}}
                <span data-tooltip="{{@root.damageRollTooltip}}">
                    {{> result roll=damage.main label=(localize "DAGGERHEART.GENERAL.damage") }}
                </span>
            {{/if}}
            {{#each damage.resources as | roll key | }}
                {{#with (lookup @root.allResourceLabels key) as | labelData |}}
                    {{> result roll=roll label=(localize (ifThen ../../hasHealing labelData.label labelData.inChatRoll)) }}
                {{/with}}
            {{/each}}
        </div>
    </div>
    <div class="roll-part-content dice-result">
        <div class="dice-tooltip">
            <div class="wrapper">
                {{#if damage.main}}
                    {{> damage label=(localize "DAGGERHEART.GENERAL.damage") roll=damage.main isDirect=isDirect totalTooltip=@root.damageRollTooltip }}
                {{/if}}

                {{#each damage.resources as |roll key| }}
                    {{#with (lookup @root.allResourceLabels key) as | labelData |}}
                        {{> damage
                            label=(localize (ifThen ../../hasHealing labelData.label labelData.inChatRoll)) 
                            roll=roll
                            resource=key
                        }}
                    {{/with}}
                {{/each}}
            </div>
        </div>
    </div>
</div>

{{#*inline "result"}}
    <div class="roll-formula">
        {{label}}:
        {{#if roll.options.fullRestore}}
            {{localize "DAGGERHEART.ACTIONS.Settings.fullRestore.inChatRoll"}}
        {{else}}
            {{roll.total}}
            {{#if roll.options.damageTypes.length}}
                {{#each @root.damageTypes as |type|}}
                    <i class="{{type.icon}}" data-tooltip aria-label="{{localize type.label}}"></i>
                {{/each}}
            {{/if}}
        {{/if}}
    </div>
{{/inline}}

{{#*inline "damage"}}
    <fieldset>
        <legend>
            {{label}}
            <div class="roll-formula">{{localize "DAGGERHEART.GENERAL.total"}}: {{#if roll.options.fullRestore}}{{localize "DAGGERHEART.ACTIONS.Settings.fullRestore.inChatRoll"}}{{else}}{{roll.total}}{{/if}}</div>{{#if isDirect}} <div class="roll-formula">{{localize "DAGGERHEART.CONFIG.DamageType.direct.short"}}</div>{{/if}}
        </legend>
        {{#if (and (not @root.hasHealing) roll.options.damageTypes.length)}}
            <label class="roll-part-header">
                <span>
                    {{#each @root.damageTypes as |type|}}
                        {{localize type.label}}
                        {{#unless @last}}/{{/unless}}
                    {{/each}}
                    <div class="roll-formula">{{roll.total}}</div>
                </span>
            </label>
        {{/if}}
        {{#unless roll.options.fullRestore}}
        <div class="roll-dice">
            {{#if roll.dice.length}}
                {{#each roll.dice as |dice diceKey|}}
                    {{#each results as |dieResult resultKey|}}
                        {{#if active}}
                            <div class="roll-die{{#unless @../first}} has-plus{{/unless}}">
                                <div 
                                    class="dice reroll-button {{coalesce dieResult.denomination dice.denomination}}" 
                                    data-type="damage" data-dice="{{diceKey}}" data-result="{{resultKey}}" {{#if ../../resource}}data-damage-type="{{../../resource}}" data-is-resource="true"{{/if}}
                                >
                                    {{#if dieResult.rerolled}}<i class="fa-solid fa-dice dice-rerolled" data-tooltip="{{localize "DAGGERHEART.GENERAL.rerolled"}}"></i>{{/if}}
                                    {{result}}
                                </div>
                            </div>
                        {{/if}}
                    {{/each}}
                {{/each}}
                
                {{#if roll.modifierTotal}}
                    <div class="roll-die{{#if (gt roll.modifierTotal 0)}} has-plus{{/if}}" {{#if totalTooltip}}data-tooltip="{{totalTooltip}}"{{/if}}>
                        <div class="font-20">{{roll.modifierTotal}}</div>
                    </div>
                {{/if}}
            {{else}}
                <div class="roll-die">
                    <div class="font-20">{{roll.total}}</div>
                </div>
            {{/if}}
        </div>
        {{/unless}}
    </fieldset>
{{/inline}}