<div class="daggerheart dh-style tooltip">
    <div class="tooltip-header">
        <h3>{{effect.name}}</h3>
        <div class="helper">{{localize "[Right Click] Remove Effect"}}</div>
    </div>
    <div>
        {{#if effect.description}}{{{effect.description}}}{{else}}{{{effect.parent.system.description}}}{{/if}}
    </div>
</div>