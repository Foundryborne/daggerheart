<div class="daggerheart dh-style tooltip basic">
    <div class="tooltip-title-container">
        <img class="tooltip-image" src="{{img}}" />
        <h2 class="tooltip-title">{{localize name}}</h2>
    </div>
    {{#if tags.length}}
        <div class="tags">
            {{#each tags as |tag|}}
                <div class="tag">
                    <span>{{tag}}</span>
                </div>
            {{/each}}
        </div>
    {{/if}}
    {{#if description}}
        <div class="tooltip-description dh-card-description">{{{localize description}}}</div>
    {{/if}}
    {{#if duration}}
        <div class="tooltip-duration  dh-card-description">
            <div class="duration-inner-container">
                <span class="label">{{localize "EFFECT.DURATION.Label"}}:</span>
                <span>{{localize (concat "DAGGERHEART.CONFIG.ActiveEffectDuration." duration )}}</span>
            </div>
        </div>
    {{/if}}
</div>