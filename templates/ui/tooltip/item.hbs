<div class="daggerheart dh-style tooltip armor card-style">
    <img class="tooltip-image" src="{{item.img}}" />
    <h2 class="tooltip-title">{{item.name}}</h2>
    {{#if tags.length}}
        <div class="tags">
            {{#each tags as |tag|}}
                <div class="tag">
                    <span>{{tag}}</span>
                </div>
            {{/each}}
        </div>
    {{/if}}
    {{#if description}}
        <div class="tooltip-description dh-card-description">{{{description}}}</div>
    {{/if}}

    <p class="tooltip-hint">
        <i class="fa-solid fa-computer-mouse"></i> {{localize "DAGGERHEART.UI.Tooltip.middleClick"}}
    </p>
</div>