  "items": [
    {
      "name": "Blink Beast",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>When combat begins, place a duplicate within Close range of the @Lookup[@name]. The @Lookup[@name] occupies both its place and its duplicate's. The duplicate can move when the @Lookup[@name] is spotlighted, and the @Lookup[@name] can target enemies with attacks as if it were in its duplicate's place. When the @Lookup[@name] or duplicate is attacked, the attacker rolls a <strong>[[/r d6]]</strong>. On an even result, they target the @Lookup[@name]. On an odd result, they target the duplicate, and the attack fails. If an attack succeeds against the @Lookup[@name], the duplicate is dispelled until you <strong>spend a Fear</strong> to conjure it again.</p>",
        "attribution": {},
