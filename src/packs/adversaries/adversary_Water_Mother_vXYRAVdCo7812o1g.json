    {
      "name": "Constrict",
      "type": "feature",
      "system": {
        "featureForm": "action",
        "description": "<p><strong>Mark a Stress</strong> to make an attack against all targets within Melee range of the Center segment. Targets the attack succeeds against take <strong>4d8+8</strong> physical damage and are temporarily <em>Restrained</em>. At the beginning of each GM turn, you can <strong>mark a Stress</strong> to force all targets <em>Restrained</em> by the @Lookup[@name] to mark a HP.</p>",
        "attribution": {},
