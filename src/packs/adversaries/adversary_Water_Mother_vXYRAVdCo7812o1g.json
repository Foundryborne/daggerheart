    {
      "name": "Eat the World",
      "type": "feature",
      "system": {
        "featureForm": "action",
        "description": "<p><strong>Spend a Fear</strong> to have the @Lookup[@name] inhale sharply. Each PC within Close range of her Head must succeed on a Strength Reaction Roll or mark a Stress and be pulled within Melee range of the Head. The @Lookup[@name] then makes a standard attack against all targets within Melee range of her Head.</p>",
        "attribution": {},
        "gmNotes": "",
