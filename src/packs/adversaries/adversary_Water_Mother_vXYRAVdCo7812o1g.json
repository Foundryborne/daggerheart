  "items": [
    {
      "name": "Segmented",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>The @Lookup[@name]'s body is divided into three segments: Head, Center, and Tail. The @Lookup[@name] always moves from the Head first, pulling the Center and then Tail behind it. A creature can target the @Lookup[@name] with an attack as long as at least one of her segments is within range, but the @Lookup[@name] can make a standard attack only against a target within range of her Head. If an attack deals damage to the @Lookup[@name] and her Head is within range, the attack deals an extra <strong>1d10</strong> damage.</p>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "originItemType": null,
        "multiclassOrigin": false
      },
