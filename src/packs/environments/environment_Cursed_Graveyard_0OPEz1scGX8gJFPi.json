  "type": "environment",
  "name": "Cursed Graveyard",
  "folder": "GQ0VnOLrKBIHR6Us",
  "system": {
    "type": "exploration",
    "description": "<p>A sprawling cemetery filled with crumbling headstones, twisted trees possessed by the dead, and crypts overgrown with moss and ivy.</p>",
    "tier": 1,
    "impulses": "Bury them six feet deep, choke with fog, lure with promises of entombed treasure, unleash the restless dead",
    "difficulty": 11,
    "attribution": {
      "source": "Daggerheart SRD",
      "page": null
    },
