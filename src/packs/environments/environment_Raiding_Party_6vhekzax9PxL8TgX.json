  "name": "Raiding Party",
  "folder": "GQ0VnOLrKBIHR6Us",
  "system": {
    "type": "event",
    "description": "<p>A pirate ship disgorges its crew into a port town or shoreline village to loot and plunder.</p>",
    "tier": 1,
    "impulses": "Light it on fire, overwhelm with speed and numbers, take everything that isn't nailed down",
    "difficulty": 11,
