  "folder": "GQ0VnOLrKBIHR6Us",
  "system": {
    "type": "social",
    "description": "<p>Commoners and nobles alike gather from the surrounding area for a weeklong celebration.</p>",
    "tier": 1,
    "impulses": "Express local culture and history, forge new relationships, reinforce community",
    "difficulty": 11,
    "attribution": {
      "source": "Daggerheart H&F"
    },
