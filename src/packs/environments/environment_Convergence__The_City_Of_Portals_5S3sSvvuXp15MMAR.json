    {
      "name": "Into the Multiverse",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>The city of Convergence has a portal or door to every realm of existence.</p><section id=\"secret-Tu6AYVy5cD2UXJxq\" class=\"secret\"><p>Where (or when) does the party want to go? Where is that portal located, and who controls that area?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "granter": null
      },
      "_id": "cVL5PXbDsM7wccZf",
