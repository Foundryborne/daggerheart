  "name": "Convergence, The City Of Portals",
  "folder": "IKumu5HTLqONLYqb",
  "system": {
    "type": "social",
    "description": "<p>A sprawling metropolis at the nexus of creation, where influential figures from across the realms gather.</p>",
    "tier": 4,
    "impulses": "Confront them with alien customs, dazzle them with infinite variety, tempt them with the impossible",
