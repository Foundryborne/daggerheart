      },
      "_key": "!actors.items!sstO8KJz1VeYv2hZ.9igGCe0LCHvsNmFx"
    },
    {
      "name": "Abandon All Hope",
      "type": "feature",
      "system": {
        "featureForm": "reaction",
        "description": "<p>When a PC spends Hope in the Realm of the Dead, they must roll a <strong>d6</strong>. On an odd result, they must spend an additional Hope or lose the benefit of the Hope they already spent.</p><section id=\"secret-hlBMll2qdg3GxQEF\" class=\"secret\"><p>What regrets gnaw at the edge of your consciousness while you're here? What memories still tether you to the Mortal Realm?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "originItemType": null,
        "multiclassOrigin": false
      },
