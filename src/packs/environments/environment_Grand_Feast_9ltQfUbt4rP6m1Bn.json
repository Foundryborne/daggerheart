  "items": [
    {
      "name": "Loose Lips & Fast Friends",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>Everyone is here to have a good time. PCs have advantage on Presence Rolls to socialize with other revelers.</p><section id=\"secret-flXbBm0IURcfsAGo\" class=\"secret\"><p>What is everyone celebrating? Where's the party? Who's footing the bill?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "originItemType": null,
        "multiclassOrigin": false
      },
      "_id": "FcbTcbTe6fcl5nCe",
