  "items": [
    {
      "name": "Bigger on the Inside",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>Though the hut's exterior is a rustic single-room cottage, the interior is an ever-shifting estate of haunting splendor replete with numerous bedrooms, libraries, and indoor gardens, among other mysterious installations.</p><section id=\"secret-AuLFdOj4EBR4QBZk\" class=\"secret\"><p>Is there any pattern to the way the hut rearranges itself? What is the most surprising location the PCs could find here?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "granter": null
      },
      "_id": "bukvnYnF0f1Q3tfQ",
      "img": "icons/magic/perception/eye-ringed-green.webp",
