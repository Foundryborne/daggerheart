  "system": {
    "type": "social",
    "description": "<p>The party takes a break from their adventure for some rest and relaxation in a seaside settlement.</p>",
    "tier": 2,
    "impulses": "Conjure images of sand and surf, give them a breather, prepare them for the conflict ahead",
    "difficulty": 14,
    "attribution": {
      "source": "Daggerheart SRD",
      "page": null
    },
    "potentialAdversaries": {},
    "notes": ""
  },
  "items": [
    {
      "name": "R&R",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>The party finds themselves in a location where the concerns and conflicts of the outside world melt away. When the PCs rest here, they gain an additional downtime move, the GM doesn't gain Fear, and no long-term countdowns advance.</p><section id=\"secret-UDQmua9neWETFUfG\" class=\"secret\"><p>What's so relaxing about this place? Does it remind you of somewhere you've been before?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "granter": null
      },
