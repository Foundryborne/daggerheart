    {
      "name": "Relative Strength",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>The Difficulty of this environment equals that of the adversary who issued the challenge.</p><section id=\"secret-FvJjn9p0QgNrJxXT\" class=\"secret\"><p>Who issues the challenge? What are they fighting for?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "granter": null
      },
      "_id": "XEMJowsrU7kCC4Ys",
