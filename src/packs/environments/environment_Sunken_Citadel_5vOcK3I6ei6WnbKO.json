    },
    {
      "name": "Lost Technology",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>The ruins are carved with strange magical runes and littered with lost technology. A PC can make a Knowledge Roll to learn useful information about this lost civilization from any runes or devices they come across.</p><section id=\"secret-llwozvmLvAjTkujl\" class=\"secret\"><p>Who once called this place home? How did their technology work? Why were they ultimately destroyed and cast down into the depths?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "granter": null
      },
      "_id": "3RsgTnVijii6AMbF",
      "img": "icons/commodities/tech/metal-blue.webp",
