    {
      "name": "Air Pockets",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>A PC can reset their their Air Supply Countdown to its starting value by locating a pocket of air with a successful Knowledge or Instinct Roll.</p><section id=\"secret-AirJX0Oi7mBQoiWl\" class=\"secret\"><p>What signs or structures do you look for? What does it feel like to know this might be the last breath you take?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "granter": null
      },
      "_id": "99n3FQmcE0rszkrT",
