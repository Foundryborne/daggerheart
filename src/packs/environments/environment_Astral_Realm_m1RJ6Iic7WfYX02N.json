      },
      "_key": "!actors.items!m1RJ6Iic7WfYX02N.y76PmjDZYo1JXqnF"
    },
    {
      "name": "Astral Adversaries",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>Adversaries in the Astral Realm are immune to physical damage, as they are psychic projections instead of flesh and blood.</p><section id=\"secret-O97MIbXqdcZUKa6a\" class=\"secret\"><p>How does an adversary's astral form differ from their physical form? Why are these psychic projections drawn to the PCs?</p></section>",
        "attribution": {},
