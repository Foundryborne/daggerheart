      },
      "_key": "!actors.items!m1RJ6Iic7WfYX02N.Fq76Ws72FOecLook"
    },
    {
      "name": "Mental Manifestations",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>With a successful Knowledge Roll, PCs can alter the psychic environment, such as by inverting gravity or conjuring a rapidly self-assembling staircase. A PC can use a mental manifestation once per scene to gain advantage on a roll to navigate the Astral Realm.</p><section id=\"secret-ER9W41lXmtlfbQhF\" class=\"secret\"><p>Is the construct you manifest a memory from real life or a figment of your own imagination? What key detail do you focus on to make it more stable?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "originItemType": null,
        "multiclassOrigin": false
      },
      "_id": "7NjcuEJmBXwnljrt",
