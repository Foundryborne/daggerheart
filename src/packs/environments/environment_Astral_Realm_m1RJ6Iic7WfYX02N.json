      },
      "_key": "!actors.items!m1RJ6Iic7WfYX02N.7NjcuEJmBXwnljrt"
    },
    {
      "name": "Matter Is Illusion",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>Countdown (10). Time and distance are relative here, and simply moving through the space requires an act of will. To cross the Astral Realm, the party must complete the countdown using only Knowledge, Instinct, or Presence Rolls. On a failure with Fear, a PC takes <strong>3d8</strong> direct magic damage.</p><section id=\"secret-Mn5Z8o43Wzq27aTW\" class=\"secret\"><p>Do you think or feel your way through this place? What difference does it make here?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "originItemType": null,
        "multiclassOrigin": false
      },
      "_id": "y76PmjDZYo1JXqnF",
      "img": "icons/magic/perception/eye-ringed-green.webp",
      "effects": [],
      "folder": null,
      "sort": 0,
      "flags": {},
      "_stats": {
