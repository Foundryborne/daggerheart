  "items": [
    {
      "name": "Out-of-Body Experience",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>Because the party isn't physically in this realm, Strength, Agility, and Finesse Rolls automatically fail. Additionally, when a character would mark a HP, they must lose a Hope or mark a Stress instead. If a character can't mark a Stress, they must make a death move.</p><section id=\"secret-A45bSa6klHKxPj9D\" class=\"secret\"><p>How does the projection of your mental self-image differ from your physical appearance? Which one do you consider the \"real\" you?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "originItemType": null,
        "multiclassOrigin": false
      },
      "_id": "Fq76Ws72FOecLook",
