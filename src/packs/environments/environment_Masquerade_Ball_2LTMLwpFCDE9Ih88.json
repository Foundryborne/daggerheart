  "items": [
    {
      "name": "Costumes Required",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>Everyone at the ball is expected to arrive in costume. PCs have advantage on Presence Rolls to convince others they are someone—or something—they're not.</p><section id=\"secret-AG9eLROeP0oeQwD9\" class=\"secret\"><p>What do the PCs come dressed as? What do their costumes reveal about their true selves?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "granter": null
      },
      "_id": "BrmEXZ6Nowpg7LRS",
