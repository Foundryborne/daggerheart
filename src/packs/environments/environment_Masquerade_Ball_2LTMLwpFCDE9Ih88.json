      },
      "_key": "!actors.items!2LTMLwpFCDE9Ih88.BrmEXZ6Nowpg7LRS"
    },
    {
      "name": "\"Care to Dance?\"",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>While dancing, a PC can make an Agility Roll instead of a Presence Roll to influence others.</p><section id=\"secret-Xi3GbKgbKvxZGUmM\" class=\"secret\"><p>What's notable or unique about the dances that are in fashion here? Where did the PCs learn how to perform them?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "granter": null
      },
      "_id": "AkVcdbmlKOIBAkp6",
